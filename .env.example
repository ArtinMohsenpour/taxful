DATABASE_URL=postgresql://taxful:YOUR_LOCAL_PASSWORD@127.0.0.1:5436/taxful
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Customer authentication uses its own schema and secret.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=GENERATE_A_RANDOM_SECRET_WITH_CUSTOMER_SETUP
# Optional: separate database with a role limited to the customer_auth schema.
# CUSTOMER_DATABASE_URL=postgresql://customer_app:PASSWORD@HOST:5432/DATABASE

# Local inbox: http://localhost:8026 (pnpm customer:mail)
CUSTOMER_SMTP_HOST=127.0.0.1
CUSTOMER_SMTP_PORT=1026
CUSTOMER_SMTP_SECURE=false
CUSTOMER_EMAIL_FROM="Taxful <no-reply@taxful.test>"
# Production SMTP credentials:
# CUSTOMER_SMTP_USER=
# CUSTOMER_SMTP_PASSWORD=
