DATABASE_URL=postgresql://taxful:YOUR_LOCAL_PASSWORD@127.0.0.1:5436/taxful
# Used by docker-compose.yml; must match DATABASE_URL
POSTGRES_USER=taxful
POSTGRES_PASSWORD=YOUR_LOCAL_PASSWORD
POSTGRES_DB=taxful
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Customer authentication uses its own schema and secret.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=GENERATE_A_RANDOM_SECRET_WITH_CUSTOMER_SETUP
# Production: choose the header overwritten by your trusted ingress. Block direct origin access.
# CUSTOMER_IP_HEADER=x-forwarded-for
# Only actual proxy IPs/CIDRs, never a blanket private-network range. See docs/security-hardening.md.
# CUSTOMER_TRUSTED_PROXIES=
# Optional: separate database with a role limited to the customer_auth schema.
# CUSTOMER_DATABASE_URL=postgresql://customer_app:PASSWORD@HOST:5432/DATABASE

# Local inbox: http://localhost:8026 (pnpm customer:mail)
CUSTOMER_SMTP_HOST=127.0.0.1
CUSTOMER_SMTP_PORT=1026
CUSTOMER_SMTP_SECURE=false
CUSTOMER_EMAIL_FROM="Taxful <no-reply@taxful.test>"
# Invoice delivery: Mailpit only, with a loopback BETTER_AUTH_URL.
# pnpm dev defaults to mailpit. Set disabled to turn it off.
INVOICE_EMAIL_MODE=mailpit
# Production SMTP credentials:
# CUSTOMER_SMTP_USER=
# CUSTOMER_SMTP_PASSWORD=

# Document processing (server-only). Start with synthetic/anonymized documents.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
DOCUMENT_AI_ENABLED=true
DOCUMENT_STORAGE_PATH=.private/documents
DOCUMENT_MAX_FILE_MB=10
DOCUMENT_MAX_PAGES=30
DOCUMENT_DAILY_LIMIT=10
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
XRECHNUNG_VALIDATOR_URL=http://127.0.0.1:8086

# Local PDF/A-3 + CII generation and validation service
ZUGFERD_SERVICE_URL=http://127.0.0.1:8087

# Stripe TEST credentials only. Manage plan prices and discounts in /admin/billing.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# pnpm dev automatically starts the Stripe CLI test listener; disable only if forwarding separately.
STRIPE_LOCAL_WEBHOOKS=true

# Password screening is mandatory for new/changed/reset passwords (never login).
# Choose local (no outbound lookup) or hibp (sends only five SHA-1 prefix characters).
PASSWORD_SCREENING_MODE=hibp
# Generate a sorted fixed-width corpus with pnpm security:corpus INPUT OUTPUT.
# No sample corpus is suitable for production. Refresh at least monthly.
# PASSWORD_BLOCKLIST_PATH=/private/security/pwned-passwords.sha1
# Non-local deployments must block direct-origin access and overwrite one IP header.
# Set only after verifying that ingress contract; never accept client-supplied chains.
# SECURITY_PROXY_CONTRACT=overwrite-single-ip
# Random independent 32+ character bearer secret for /api/security/health.
# SECURITY_MONITOR_TOKEN=
# Run pnpm security:worker as a supervised production service (included in pnpm dev).
