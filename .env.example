DATABASE_URL=postgresql://taxful:YOUR_LOCAL_PASSWORD@127.0.0.1:5436/taxful
# Used by docker-compose.yml; must match DATABASE_URL
POSTGRES_USER=taxful
POSTGRES_PASSWORD=YOUR_LOCAL_PASSWORD
POSTGRES_DB=taxful
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Customer authentication uses its own schema and secret.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=GENERATE_A_RANDOM_SECRET_WITH_CUSTOMER_SETUP
# Optional: separate database with a role limited to the customer_auth schema.
# CUSTOMER_DATABASE_URL=postgresql://customer_app:PASSWORD@HOST:5432/DATABASE

# Local inbox: http://localhost:8026 (pnpm customer:mail)
CUSTOMER_SMTP_HOST=127.0.0.1
CUSTOMER_SMTP_PORT=1026
CUSTOMER_SMTP_SECURE=false
CUSTOMER_EMAIL_FROM="Taxful <no-reply@taxful.test>"
# Production SMTP credentials:
# CUSTOMER_SMTP_USER=
# CUSTOMER_SMTP_PASSWORD=

# Document processing (server-only). Start with synthetic/anonymized documents.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
DOCUMENT_AI_ENABLED=true
DOCUMENT_STORAGE_PATH=.private/documents
DOCUMENT_MAX_FILE_MB=10
DOCUMENT_MAX_PAGES=30
DOCUMENT_DAILY_LIMIT=10
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
XRECHNUNG_VALIDATOR_URL=http://127.0.0.1:8086

# Local PDF/A-3 + CII generation and validation service
ZUGFERD_SERVICE_URL=http://127.0.0.1:8087

# Stripe TEST credentials only. Manage plan prices and discounts in /admin/billing.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# pnpm dev automatically starts the Stripe CLI test listener; disable only if forwarding separately.
STRIPE_LOCAL_WEBHOOKS=true
