{
  "name": "taxful",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "documents:worker": "tsx scripts/document-worker.ts",
    "documents:services": "docker compose -f docker-compose.documents.yml up -d --build",
    "test:documents": "tsx --test tests/documents/*.test.ts",
    "customer:setup": "tsx scripts/setup-customer-auth.ts",
    "customer:migrate": "tsx scripts/customer-migrate.ts",
    "customer:mail": "docker compose -f docker-compose.email.yml up -d",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "tsx scripts/dev.ts",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@better-auth/infra": "^0.4.9",
    "@google/genai": "2.22.0",
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/live-preview-react": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "better-auth": "1.7.4",
    "cross-env": "^7.0.3",
    "decimal.js": "10.6.0",
    "dotenv": "16.4.7",
    "fast-xml-parser": "5.11.1",
    "file-type": "22.1.0",
    "graphql": "^16.8.1",
    "mammoth": "1.12.3",
    "next": "16.3.3",
    "next-intl": "4.14.3",
    "next-themes": "0.4.6",
    "nodemailer": "10.0.9",
    "payload": "3.89.0",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2",
    "xmlbuilder2": "4.0.3",
    "yauzl": "3.4.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "postcss": "8.5.28",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "next-themes@0.4.6": "patches/next-themes@0.4.6.patch"
    }
  }
}
